# GHCR images (must match your GitHub Actions package names)
BACKEND_IMAGE=ghcr.io/4fourceinternal/4fource-be:latest
FRONTEND_IMAGE=ghcr.io/4fourceinternal/4fource-fe:latest

# Host ports
WEB_PORT=8080
STRAPI_PORT=1337

# Public Strapi URL (admin + media) — your real admin/API host
PUBLIC_URL=https://admin.4fource.com

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=strapi
MYSQL_USER=strapi
MYSQL_PASSWORD=change-me-strapi

# Copy from production Strapi .env (required for existing DB / admin login)
APP_KEYS=key1,key2,key3,key4
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
API_TOKEN_SALT=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me-32-characters-minimum
