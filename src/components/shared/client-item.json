{
  "collectionName": "components_shared_client_items",
  "info": {
    "displayName": "Client",
    "description": "One client: logo, name, description and project status"
  },
  "options": {},
  "attributes": {
    "clientName": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text",
      "required": false
    },
    "projectStatus": {
      "type": "enumeration",
      "enum": ["in_development", "active", "past"],
      "default": "in_development"
    }
  }
}
