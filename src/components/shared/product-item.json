{
  "collectionName": "components_shared_product_items",
  "info": {
    "displayName": "Product",
    "description": "An in-house product built by Fource Technology"
  },
  "options": {},
  "attributes": {
    "productName": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text",
      "required": false
    },
    "productStatus": {
      "type": "enumeration",
      "enum": ["in_development", "beta", "active"],
      "default": "in_development"
    },
    "productUrl": {
      "type": "string",
      "required": false
    }
  }
}
